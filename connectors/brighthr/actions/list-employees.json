{
    "name": "list-employees",
    "display_name": "List Employees",
    "description": "Retrieve a list of employees with optional filtering by department or status.",
    "method": "GET",
    "path": "/employees",
    "parameters": {
        "type": "object",
        "properties": {
            "page": {"type": "integer", "description": "Page number for pagination"},
            "per_page": {"type": "integer", "description": "Number of results per page"},
            "department": {"type": "string", "description": "Filter by department name"},
            "status": {"type": "string", "enum": ["active", "inactive"], "description": "Filter by employee status"}
        }
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "employees": {"type": "array", "items": {"type": "object"}}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
