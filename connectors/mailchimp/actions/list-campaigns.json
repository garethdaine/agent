{
    "name": "list-campaigns",
    "display_name": "List Campaigns",
    "description": "Retrieve a list of email campaigns with optional filtering by status and type.",
    "method": "GET",
    "path": "/campaigns",
    "parameters": {
        "type": "object",
        "properties": {
            "count": {"type": "integer", "description": "Number of results to return (max 1000)"},
            "offset": {"type": "integer", "description": "Number of results to skip"},
            "type": {"type": "string", "enum": ["regular", "plaintext", "absplit", "rss", "variate"], "description": "Filter by campaign type"},
            "status": {"type": "string", "enum": ["save", "paused", "schedule", "sending", "sent"], "description": "Filter by campaign status"},
            "sort_field": {"type": "string", "enum": ["create_time", "send_time"], "description": "Field to sort by"},
            "sort_dir": {"type": "string", "enum": ["ASC", "DESC"], "description": "Sort direction"}
        }
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "campaigns": {"type": "array", "items": {"type": "object"}},
            "total_items": {"type": "integer"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
