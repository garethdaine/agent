{
    "name": "list-folder",
    "display_name": "List Folder",
    "description": "List the contents of a folder in Dropbox.",
    "method": "POST",
    "path": "/files/list_folder",
    "parameters": {
        "type": "object",
        "properties": {
            "path": {"type": "string", "description": "The path to the folder (e.g. /Documents or empty string for root)"},
            "recursive": {"type": "boolean", "description": "Whether to list contents recursively"},
            "include_deleted": {"type": "boolean", "description": "Whether to include deleted entries"},
            "include_has_explicit_shared_members": {"type": "boolean", "description": "Whether to include shared member info"},
            "limit": {"type": "integer", "description": "Maximum number of results to return (max 2000)"}
        },
        "required": ["path"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "entries": {"type": "array", "items": {"type": "object"}},
            "cursor": {"type": "string"},
            "has_more": {"type": "boolean"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
