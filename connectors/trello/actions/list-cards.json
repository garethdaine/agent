{
    "name": "list-cards",
    "display_name": "List Cards",
    "description": "Retrieve all cards in a specific Trello list.",
    "method": "GET",
    "path": "/lists/{listId}/cards",
    "parameters": {
        "type": "object",
        "properties": {
            "listId": {"type": "string", "description": "The ID of the list"},
            "fields": {"type": "string", "description": "Comma-separated list of fields to include"},
            "members": {"type": "boolean", "description": "Whether to include member objects"},
            "attachments": {"type": "string", "description": "Include attachments: true, false, cover"}
        },
        "required": ["listId"]
    },
    "response_schema": {
        "type": "array",
        "items": {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "desc": {"type": "string"},
                "due": {"type": "string"},
                "idList": {"type": "string"}
            }
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
