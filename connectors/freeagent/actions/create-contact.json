{
    "name": "create-contact",
    "display_name": "Create Contact",
    "description": "Create a new contact in FreeAgent.",
    "method": "POST",
    "path": "/contacts",
    "parameters": {
        "type": "object",
        "properties": {
            "contact": {
                "type": "object",
                "properties": {
                    "first_name": {"type": "string", "description": "First name of the contact"},
                    "last_name": {"type": "string", "description": "Last name of the contact"},
                    "organisation_name": {"type": "string", "description": "Organisation name"},
                    "email": {"type": "string", "description": "Email address"},
                    "phone_number": {"type": "string", "description": "Phone number"},
                    "address1": {"type": "string"},
                    "town": {"type": "string"},
                    "region": {"type": "string"},
                    "postcode": {"type": "string"},
                    "country": {"type": "string"}
                },
                "required": ["first_name", "last_name"]
            }
        },
        "required": ["contact"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "contact": {"type": "object"}
        }
    },
    "requires_approval": true,
    "read_only": false,
    "idempotent": false,
    "pii_fields": ["email", "first_name", "last_name"]
}
