{
    "name": "update-item",
    "display_name": "Update Item",
    "description": "Update an existing item's column values via GraphQL mutation.",
    "method": "POST",
    "path": "/",
    "parameters": {
        "type": "object",
        "properties": {
            "board_id": {"type": "string", "description": "Board ID"},
            "item_id": {"type": "string", "description": "Item ID"},
            "column_values": {"type": "string", "description": "JSON string of column values to update"}
        },
        "required": ["board_id", "item_id", "column_values"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "data": {"type": "object", "properties": {"change_multiple_column_values": {"type": "object"}}}
        }
    },
    "requires_approval": true,
    "read_only": false,
    "idempotent": false,
    "pii_fields": []
}
