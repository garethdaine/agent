{
    "name": "get-board",
    "display_name": "Get Board",
    "description": "Retrieve a specific board with its items and structure.",
    "method": "GET",
    "path": "/",
    "parameters": {
        "type": "object",
        "properties": {
            "board_id": {"type": "string", "description": "Board ID"}
        },
        "required": ["board_id"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "data": {"type": "object", "properties": {"boards": {"type": "array", "items": {"type": "object"}}}}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
