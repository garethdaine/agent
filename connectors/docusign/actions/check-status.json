{
    "name": "check-status",
    "display_name": "Check Envelope Status",
    "description": "Check the status of an envelope.",
    "method": "GET",
    "path": "/accounts/{accountId}/envelopes/{envelopeId}",
    "parameters": {
        "type": "object",
        "properties": {
            "accountId": {"type": "string", "description": "DocuSign account ID"},
            "envelopeId": {"type": "string", "description": "Envelope ID"}
        },
        "required": ["accountId", "envelopeId"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "envelopeId": {"type": "string"},
            "status": {"type": "string"},
            "statusDateTime": {"type": "string"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
