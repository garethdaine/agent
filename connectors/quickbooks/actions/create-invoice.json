{
    "name": "create-invoice",
    "display_name": "Create Invoice",
    "description": "Create a new invoice in QuickBooks.",
    "method": "POST",
    "path": "/invoice",
    "parameters": {
        "type": "object",
        "properties": {
            "CustomerRef": {
                "type": "object",
                "properties": {
                    "value": {"type": "string", "description": "The customer ID"}
                },
                "required": ["value"]
            },
            "Line": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "Amount": {"type": "number"},
                        "DetailType": {"type": "string"},
                        "SalesItemLineDetail": {
                            "type": "object",
                            "properties": {
                                "ItemRef": {"type": "object", "properties": {"value": {"type": "string"}}},
                                "Qty": {"type": "number"},
                                "UnitPrice": {"type": "number"}
                            }
                        }
                    }
                },
                "description": "Array of line items"
            },
            "DueDate": {"type": "string", "description": "Due date in YYYY-MM-DD format"},
            "DocNumber": {"type": "string", "description": "Custom invoice number"}
        },
        "required": ["CustomerRef", "Line"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "Invoice": {"type": "object"}
        }
    },
    "requires_approval": true,
    "read_only": false,
    "idempotent": false,
    "pii_fields": []
}
