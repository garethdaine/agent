{
    "name": "calendar-list-events",
    "display_name": "List Calendar Events",
    "description": "Retrieve events from a Google Calendar.",
    "method": "GET",
    "path": "/calendar/v3/calendars/{calendarId}/events",
    "parameters": {
        "type": "object",
        "properties": {
            "calendarId": {"type": "string", "description": "Calendar ID (use 'primary' for default)"},
            "timeMin": {"type": "string", "description": "Lower bound for event start time (RFC3339)"},
            "timeMax": {"type": "string", "description": "Upper bound for event start time (RFC3339)"},
            "maxResults": {"type": "integer", "description": "Maximum number of events"},
            "q": {"type": "string", "description": "Free text search"}
        },
        "required": ["calendarId"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "items": {"type": "array", "items": {"type": "object"}},
            "nextPageToken": {"type": "string"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": ["items.attendees.email", "items.organizer.email"]
}
