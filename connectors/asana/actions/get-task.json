{
    "name": "get-task",
    "display_name": "Get Task",
    "description": "Retrieve detailed information about a specific Asana task.",
    "method": "GET",
    "path": "/tasks/{taskId}",
    "parameters": {
        "type": "object",
        "properties": {
            "taskId": {"type": "string", "description": "The GID of the task to retrieve"},
            "opt_fields": {"type": "string", "description": "Comma-separated list of optional fields to include"}
        },
        "required": ["taskId"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "data": {"type": "object"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
