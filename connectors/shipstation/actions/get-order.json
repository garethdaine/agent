{
    "name": "get-order",
    "display_name": "Get Order",
    "description": "Retrieve detailed information about a specific order by ID.",
    "method": "GET",
    "path": "/orders/{orderId}",
    "parameters": {
        "type": "object",
        "properties": {
            "orderId": {"type": "integer", "description": "The ID of the order"}
        },
        "required": ["orderId"]
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "orderId": {"type": "integer"},
            "orderNumber": {"type": "string"},
            "orderStatus": {"type": "string"},
            "shipTo": {"type": "object"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": ["shipTo.name", "shipTo.street1", "shipTo.phone"]
}
