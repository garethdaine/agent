{
    "name": "list-candidates",
    "display_name": "List Candidates",
    "description": "Search and retrieve a list of candidates from the Bullhorn ATS with optional query filtering.",
    "method": "GET",
    "path": "/search/Candidate",
    "parameters": {
        "type": "object",
        "properties": {
            "query": {"type": "string", "description": "Lucene-style search query for filtering candidates"},
            "fields": {"type": "string", "description": "Comma-separated list of fields to return"},
            "count": {"type": "integer", "description": "Number of results to return"},
            "start": {"type": "integer", "description": "Starting index for pagination"}
        }
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "data": {"type": "array", "items": {"type": "object"}},
            "total": {"type": "integer"},
            "count": {"type": "integer"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": ["email", "firstName", "lastName", "phone", "mobile"]
}
