{
    "name": "list-contacts",
    "display_name": "List Contacts",
    "description": "Retrieve a list of client contacts from the Vincere recruitment system.",
    "method": "GET",
    "path": "/contact",
    "parameters": {
        "type": "object",
        "properties": {
            "sort": {"type": "string", "description": "Sort field and direction"},
            "offset": {"type": "integer", "description": "Offset for pagination"},
            "limit": {"type": "integer", "description": "Number of results to return"}
        }
    },
    "response_schema": {
        "type": "object",
        "properties": {
            "result": {"type": "array", "items": {"type": "object"}},
            "total": {"type": "integer"}
        }
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": ["email", "first_name", "last_name", "phone"]
}
