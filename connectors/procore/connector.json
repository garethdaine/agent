{
    "name": "procore",
    "display_name": "Procore",
    "description": "Construction management platform for project planning, quality and safety management, RFIs, submittals, and field coordination.",
    "version": "1.0.0",
    "auth_type": "oauth2_authorization_code",
    "auth_config": {
        "authorization_url": "https://login.procore.com/oauth/authorize",
        "token_url": "https://login.procore.com/oauth/token",
        "scopes": [],
        "pkce_required": true,
        "refresh_strategy": "auto",
        "token_expiry_seconds": 7200
    },
    "base_url": "https://api.procore.com/rest/v1.1",
    "rate_limits": {
        "requests_per_minute": 3600,
        "daily_limit": 100000,
        "concurrent_limit": 10
    },
    "cost_model": "free",
    "risk_level": "standard",
    "category": "construction-management",
    "industries": ["construction"],
    "mcp_tool_prefix": "procore",
    "write_trust_threshold": 0.7,
    "pii_redaction_mode": "memory_only",
    "requires_approval_for": ["create-rfi"],
    "data_regions": ["US", "GB", "AU", "CA"],
    "webhooks": [],
    "actions": [
        {"name": "list-projects", "method": "GET", "path": "/projects"},
        {"name": "get-project", "method": "GET", "path": "/projects/{projectId}"},
        {"name": "list-rfis", "method": "GET", "path": "/projects/{projectId}/rfis"},
        {"name": "create-rfi", "method": "POST", "path": "/projects/{projectId}/rfis"},
        {"name": "list-submittals", "method": "GET", "path": "/projects/{projectId}/submittals"}
    ]
}
