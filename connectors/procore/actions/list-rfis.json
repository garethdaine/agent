{
    "name": "list-rfis",
    "display_name": "List RFIs",
    "description": "Retrieve a list of Requests for Information (RFIs) for a specific project.",
    "method": "GET",
    "path": "/projects/{projectId}/rfis",
    "parameters": {
        "type": "object",
        "properties": {
            "projectId": {"type": "integer", "description": "The ID of the project"},
            "page": {"type": "integer", "description": "Page number for pagination"},
            "per_page": {"type": "integer", "description": "Number of results per page (max 100)"},
            "filters[status]": {"type": "string", "description": "Filter by RFI status (e.g. Open, Closed, Draft)"}
        },
        "required": ["projectId"]
    },
    "response_schema": {
        "type": "array",
        "items": {"type": "object"}
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
