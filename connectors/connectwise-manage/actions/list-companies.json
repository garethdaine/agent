{
    "name": "list-companies",
    "display_name": "List Companies",
    "description": "Retrieve a list of companies from ConnectWise Manage.",
    "method": "GET",
    "path": "/company/companies",
    "parameters": {
        "type": "object",
        "properties": {
            "conditions": {"type": "string", "description": "Filter conditions (e.g. name='Acme Corp')"},
            "orderBy": {"type": "string", "description": "Field to order results by"},
            "page": {"type": "integer", "description": "Page number for pagination"},
            "pageSize": {"type": "integer", "description": "Number of results per page (max 1000)"}
        }
    },
    "response_schema": {
        "type": "array",
        "items": {"type": "object"}
    },
    "requires_approval": false,
    "read_only": true,
    "idempotent": true,
    "pii_fields": []
}
