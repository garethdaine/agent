    "actions": [
        {"name": "list-residents", "method": "GET", "path": "/residents"},
        {"name": "get-resident", "method": "GET", "path": "/residents/{residentId}"},
        {"name": "list-care-notes", "method": "GET", "path": "/residents/{residentId}/care-notes"}
