APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://agent.test
SANCTUM_STATEFUL_DOMAINS=agent.test,agent.herd.test,localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agent
DB_USERNAME=root
DB_PASSWORD=

# Dedicated test database (used by php artisan test / PHPUnit)
# Copy .env.testing.example to .env.testing and set these values.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=agent_test
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=
TEST_DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=90000
HORIZON_AGENT_MAX_PROCESSES=2

TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_PATH=
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2
TYPESENSE_HEALTHCHECK_INTERVAL_SECONDS=30
TYPESENSE_NUM_RETRIES=3
TYPESENSE_RETRY_INTERVAL_SECONDS=1
TYPESENSE_MAX_TOTAL_RESULTS=1000
TYPESENSE_IMPORT_ACTION=upsert

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-herd
REVERB_APP_SECRET=secret
REVERB_HOST="reverb.herd.test"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Runtime uses the CLI (claude/codex); API key from credential manager. No env var needed.
# RUNTIME_QUEUE=default
# Use default so `php artisan queue:work` processes runtime (no Horizon needed).
# RUNTIME_TOOL_DENY=fs.write,web
# Comma-separated tool names to deny (adapter or qualified e.g. fs.write).
# RUNTIME_TOOL_ALLOW=fs,query
# If set, only these tools are allowed (allowlist mode); tool_deny is ignored.
# AGENT_BROWSER_HEADED=1
# Show a visible browser window when the agent uses the browser tool.

# RUNTIME_WRAPPER_ENABLED=false
# Enable the persistent wrapper process (one long-lived process per session).
# RUNTIME_WRAPPER_IDLE_TIMEOUT=3600
# Seconds the wrapper waits for a new message before self-exiting.
# RUNTIME_SESSION_RESUME=true
# Use --resume session_id for Claude CLI continuity between turns.

AGENT_LICENSE_KEY=
AGENT_LICENSE_VALIDATION_URL=https://agent-ops.com/api/license/validate

AGENT_RATE_LIMIT_DEFAULT_HOLD_MINUTES=15
AGENT_RUNNER_CODEX_MODEL=gpt-5.3-codex
AGENT_INTERROGATION_BUILD_TEMPLATE_CLAUDE=
AGENT_INTERROGATION_BUILD_TEMPLATE_CODEX=
AGENT_INTERROGATION_MAX_TEXT_LENGTH=60000
AGENT_INTERROGATION_MAX_ACTIVE_SESSIONS=3
AGENT_RUNNER_CLAUDE_PATH=
AGENT_RUNNER_CODEX_PATH=
AGENT_RUNNER_CUSTOM_PATH=
AGENT_WORKING_DIRECTORY_BASES=
# Comma-separated paths for task markdown files (e.g. /path/to/storage/app/memory/context,/path/to/storage/app/delegation)
AGENT_TASK_MARKDOWN_BASES=
AGENT_ADDITIONAL_WORKING_DIRECTORY_BASES=
AGENT_ADDITIONAL_TASK_MARKDOWN_BASES=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
LINEAR_OAUTH_SCOPES="read write"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_BILLING_PORTAL_RETURN_URL=/dashboard

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

N8N_INTEGRATION_ENABLED=false
N8N_WEBHOOK_SECRET=

BILLING_ENABLED=false
STRIPE_PRICE_PILOT=
STRIPE_PRICE_MONTHLY=
STRIPE_METER_RUNS=agent_runs
STRIPE_METER_TOKENS=agent_tokens
